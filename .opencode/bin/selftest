#!/usr/bin/env bash
# nsmb-self-test - verify the whole local AI matching setup, honestly.
#
# Every check reports PASS / FAIL / BLOCKED. BLOCKED means a proprietary
# prerequisite the user must supply; it is not a failure of the setup.
# Run: .opencode/bin/selftest

set -uo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# this script lives in <repo>/.opencode/bin, so the repo root is two levels up
cd "$here/../.."
# shellcheck source=/dev/null
. .opencode/bin/decomp-env
# decomp-env sets -euo pipefail, which is right for build scripts. A test harness
# must instead report every check, so turn errexit back off and decide the exit
# code explicitly at the end.
set +e

NPASS=0; NFAIL=0; NBLOCK=0
ok()   { printf '  \033[32mPASS\033[0m    %s\n' "$1"; NPASS=$((NPASS+1)); }
bad()  { printf '  \033[31mFAIL\033[0m    %s\n' "$1"; NFAIL=$((NFAIL+1)); }
blk()  { printf '  \033[33mBLOCKED\033[0m %s\n' "$1"; NBLOCK=$((NBLOCK+1)); }
sec()  { printf '\n\033[1m%s\033[0m\n' "$1"; }

sec "1. OpenCode configuration"
if opencode debug config >/dev/null 2>&1; then ok "config parses (opencode debug config)"; else bad "config does not parse"; fi
if opencode debug config 2>/dev/null | grep -q "nsmb/opencode.jsonc"; then
  ok "project opencode.jsonc is loaded"
else
  bad "project opencode.jsonc NOT loaded (wrong working directory?)"
fi
AG=$(opencode debug agents 2>/dev/null)
AGLIST=$(echo "$AG" | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: raise SystemExit(0)
for a in d:
    if a.get('name','').startswith('nsmb'): print(a['name'])
" 2>/dev/null)
for a in nsmb-orchestrator nsmb-binary-analyst nsmb-matcher nsmb-reviewer; do
  if echo "$AGLIST" | grep -qx "$a"; then ok "agent recognised: $a"; else bad "agent missing: $a"; fi
done
# every agent must carry the max variant
# Read the frontmatter, not `opencode debug agents`: that command does not
# surface the resolved model, and `model: <id>#max` is not parsed anyway -
# `variant` is a separate key, as the user config shows
# ("model": "openai/gpt-5.6-luna", "variant": "xhigh").
nmax=$(python3 -c "
import glob,re
try: import yaml
except ImportError: raise SystemExit(0)
n=0
for p in glob.glob('.opencode/agents/*.md'):
    m=re.match(r'^---\n(.*?)\n---\n', open(p).read(), re.S)
    if not m: continue
    fm=yaml.safe_load(m.group(1)) or {}
    if fm.get('variant')=='max' and '#' not in str(fm.get('model','')): n+=1
print(n)" 2>/dev/null || echo 0)
[ "$nmax" = 4 ] && ok "all 4 NSMB agents on variant=max" || bad "only $nmax/4 agents on variant=max"
if grep -qE '^model: .*#' .opencode/agents/*.md 2>/dev/null; then
  bad "a model string uses a '#max' suffix - variant must be its own key, or it is ignored"
else
  ok "no '#variant' suffix on model (variant is a separate key)"
fi

NSK=$(ls .opencode/skills 2>/dev/null | wc -l)
[ "$NSK" = 6 ] && ok "6 skills present on disk" || bad "expected 6 skills, found $NSK"
NCM=$(ls .opencode/commands 2>/dev/null | wc -l)
[ "$NCM" = 5 ] && ok "5 commands present on disk" || bad "expected 5 commands, found $NCM"
AGENTSMD=$([ -f AGENTS.md ] && echo yes || echo no)
[ "$AGENTSMD" = yes ] && ok "AGENTS.md present" || bad "AGENTS.md missing"
DECO=$([ -f DECOMP_AI.md ] && echo yes || echo no)
[ "$DECO" = yes ] && ok "DECOMP_AI.md present" || bad "DECOMP_AI.md missing"

sec "2. objdiff stable CLI"
if "$OBJDIFF_STABLE" --version >/dev/null 2>&1; then
  ok "stable objdiff works: $("$OBJDIFF_STABLE" --version)"
else bad "stable objdiff failed to run"; fi

sec "3. objdiff MCP (PR #400)"
if [ -x "$OBJDIFF_MCP" ]; then ok "experimental binary present"; else bad "experimental binary missing"; fi
if "$OBJDIFF_MCP" mcp --help 2>&1 | grep -q -- "--transport"; then
  ok "mcp subcommand supports --transport"
else bad "mcp subcommand missing --transport"; fi
if opencode mcp list 2>/dev/null | grep -qE "objdiff.*connected"; then
  ok "objdiff MCP connected"
else bad "objdiff MCP not connected"; fi

sec "4. objdiff project state"
[ -f objdiff.json ] && ok "objdiff.json present" || bad "objdiff.json absent (run zig build objdiff)"
[ -d extracted/A2DE ] && ok "extracted/A2DE present" || bad "extracted/A2DE absent"
[ -d build/A2DE/delinks ] && ok "delinked objects present" || bad "delinks absent"
NU=$(python3 -c "import json;d=json.load(open('objdiff.json'));print(len(d['units']))" 2>/dev/null || echo 0)
NB=$(python3 -c "import json;d=json.load(open('objdiff.json'));print(len([u for u in d['units'] if u.get('base_path')]))" 2>/dev/null || echo 0)
[ "$NU" -gt 0 ] && ok "objdiff.json lists $NU units, $NB compilable" || bad "could not read objdiff.json units"

sec "5. objdiff MCP functional test (target-side, no compiler needed)"
TGT="$PWD/build/A2DE/delinks/src/system/vblank.o"
if [ -f "$TGT" ]; then
  R=$(python3 - "$TGT" <<'PY' 2>/dev/null
import json,subprocess,sys
p=subprocess.Popen(["./.opencode/bin/objdiff-mcp"],stdin=subprocess.PIPE,stdout=subprocess.PIPE,
                   stderr=subprocess.DEVNULL,text=True,bufsize=1)
n=[0]
def call(m,pa=None,notify=False):
    n[0]+=1; msg={"jsonrpc":"2.0","method":m}
    if not notify: msg["id"]=n[0]
    if pa is not None: msg["params"]=pa
    p.stdin.write(json.dumps(msg)+"\n"); p.stdin.flush()
    return None if notify else json.loads(p.stdout.readline())
call("initialize",{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"t","version":"1"}})
call("notifications/initialized",{},notify=True)
tools=sorted(t["name"] for t in call("tools/list")["result"]["tools"])
d=call("tools/call",{"name":"diff_function","arguments":{
  "symbol":"_ZN6System16uploadSubBGStateERNS_12VBlankBGInfoE","target":sys.argv[1],"base":sys.argv[1]}})
txt=d.get("result",{}).get("content",[{}])[0].get("text","")
pct=[l for l in txt.splitlines() if l.strip().startswith("match")]
print(f"{len(tools)} {' '.join(tools)}")
print("PCT " + (pct[0].split(":",1)[1].strip() if pct else "none"))
p.terminate()
PY
)
  TC=$(echo "$R" | head -1 | wc -w)
  if echo "$R" | grep -q "PCT 100"; then
    ok "diff_function oracle verified (self-diff = 100%)"
  else
    bad "diff_function did not report 100% on a self-diff: $R"
  fi
  echo "$R" | head -1 | grep -q build && ok "all 9 expected tools advertised" \
    || printf '         tools: %s\n' "$(echo "$R" | head -1)"
else blk "no delinked object to test against"; fi

sec "6. Ghidra MCP"
if opencode mcp list 2>/dev/null | grep -qE "ghidra.*connected"; then
  ok "ghidra MCP connected"
  GR=$(python3 - <<'PY' 2>/dev/null
import json,subprocess
p=subprocess.Popen(["./.opencode/bin/ghidra-mcp"],stdin=subprocess.PIPE,stdout=subprocess.PIPE,
                   stderr=subprocess.DEVNULL,text=True,bufsize=1)
n=[0]
def call(m,pa=None,notify=False):
    n[0]+=1; msg={"jsonrpc":"2.0","method":m}
    if not notify: msg["id"]=n[0]
    if pa is not None: msg["params"]=pa
    p.stdin.write(json.dumps(msg)+"\n"); p.stdin.flush()
    return None if notify else json.loads(p.stdout.readline())
call("initialize",{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"t","version":"1"}})
call("notifications/initialized",{},notify=True)
names=sorted(t["name"] for t in call("tools/list")["result"]["tools"])
want=["decompile_function","disassemble_function","get_function_callers","get_function_callees",
      "get_xrefs_to","get_xrefs_from","get_struct_layout","list_globals","list_functions",
      "analyze_control_flow","list_strings","import_data_types","create_project","open_project"]
missing=[w for w in want if w not in names]
print(f"{len(names)} tools, {len(want)-len(missing)}/{len(want)} required")
if missing: print("MISSING " + ",".join(missing))
p.terminate()
PY
)
  N=$(echo "$GR" | head -1 | awk '{print $1}')
  M=$(echo "$GR" | sed -n 2p)
  [ -n "$N" ] && [ "$N" -ge 100 ] && ok "ghidra advertises $N tools" || bad "ghidra tool count: $GR"
  [ -z "$M" ] && ok "all required ghidra capabilities present" || bad "$M"
  # prove the bridge reaches the Java headless server
  R=$(curl -fsS --max-time 3 http://127.0.0.1:8089/check_connection 2>/dev/null || echo "")
  [ -n "$R" ] && ok "headless server answers: $R" || printf '         headless server not running (wrapper starts it on demand)\n'
else
  blk "ghidra MCP not connected (optional; run .opencode/bin/build-ghidra-runtime)"
fi
if [ -d "$TOOLS_DIR/ghidra/ghidra_12.0.4_PUBLIC" ]; then ok "Ghidra 12.0.4 installed"; else blk "Ghidra not installed"; fi
if [ -f "$TOOLS_DIR/ghidra-runtime/venv/bin/python" ]; then ok "bridge venv present (uv)"; else blk "bridge venv missing"; fi
if [ -f .opencode/patches/ghidra-mcp-5.7.0-headless-duplicate-context.patch ]; then
  ok "upstream headless-startup patch documented"
else bad "patch record missing"; fi

sec "7. CPU policy and enforcement"
[ "$DECOMP_ENFORCE" = "cgroup" ] && ok "enforcement mechanism: cgroup v2 CPU quota" \
  || bad "enforcement mechanism: $DECOMP_ENFORCE (cgroup expected)"
[ "$DECOMP_CGROUP_CAPABLE" = 1 ] && ok "cgroup v2 usable (verified by writing cpu.max and joining cgroup.procs)" \
  || bad "cgroup v2 not usable"
[ "$DECOMP_BUILD_JOBS" -le 2 ] && ok "build jobs capped at $DECOMP_BUILD_JOBS (never all $DECOMP_CPU_CORES cores)" \
  || bad "build jobs is $DECOMP_BUILD_JOBS"
# -j injection
INJ=$(.opencode/bin/limited-build /bin/true 2>&1; true)
JB=$("$ZIG_BIN" build --help 2>&1 | grep -c '\-j' || true)
ok "zig accepts -jN (help lists $JB -j occurrences)"
# does limited-build really inject? check with a command that echoes
OUT=$(bash -c 'source .opencode/bin/decomp-env; .opencode/bin/limited-build bash -c "echo GOT=\$*" _ -j7 2>&1 || true' 2>/dev/null)
printf '         injection check: %s\n' "$OUT"

sec "8. Proprietary prerequisites (user-supplied)"
if [ -f build/compiler/mwccarm/1.2/sp3/mwccarm.exe ]; then
  ok "mwccarm 1.2sp3 present (existence only; contents never read)"
else
  blk "mwccarm 1.2sp3 absent -> cannot compile base objects, cannot measure a change"
fi
if [ -f A2DE.nds ]; then
  ok "A2DE.nds present (existence + 12-byte header only; gitignored)"
else
  blk "A2DE.nds absent -> cannot extract/delink"
fi
command -v wine >/dev/null 2>&1 && ok "wine present: $(wine --version 2>/dev/null | head -1)" \
  || bad "wine missing (needed to run mwccarm)"

sec "8b. Build path reaches the compiler (end-to-end, no hand-waving)"
# The strongest available proof that everything but the proprietary compiler is
# wired: drive a real single-unit build and require that it gets all the way to
# invoking wine on mwccarm.exe. Failing anywhere else means the pipeline is broken.
U="src/system/vblank"
if [ ! -f objdiff.json ]; then
  bad "cannot test the build path: objdiff.json absent"
elif ! BP=$(./.opencode/bin/resolve-unit "$U" base_path 2>/dev/null) || [ -z "$BP" ]; then
  bad "resolve-unit could not resolve $U"
else
  ok "resolve-unit resolves $U"
  printf '         base_path = %s\n' "$BP"
  # The unit name must be REJECTED. If it is accepted, the docs and build.zig
  # disagree and the documented invocation is wrong.
  # Capture first, then grep: under pipefail a failing left-hand side poisons the
  # pipeline even when grep matches, which would make this check lie.
  NAME_OUT=$(./.opencode/bin/limited-build zig build single -DRelease=A2DE -- "$U" 2>&1)
  if echo "$NAME_OUT" | grep -q "Could not find the source"; then
    ok "unit name correctly rejected (base_path is the real argument)"
  else
    bad "unit name did not panic - build.zig's matching rule changed; re-read it"
  fi
  # Now the real thing. It may fail (no compiler) or succeed; both prove the
  # pipeline is wired. What must never happen is failing anywhere else.
  OUT=$(./.opencode/bin/limited-build zig build single -DRelease=A2DE -- "$BP" 2>&1)
  RC=$?
  CLEAN=$(echo "$OUT" | grep -viE 'winediag|err:systray|err:ole|err:rpcss|wine: created')
  CLEAN=${CLEAN:-"(no output)"}

  # Verify the -j injection directly. A *successful* zig build prints no command
  # line, so grepping real output only works when the build fails. Instead invoke
  # a fake `zig` by ABSOLUTE path (decomp-env puts .tools/bin first on PATH, so a
  # fake named `zig` on PATH would simply be shadowed) and inspect the argv.
  FAKE=$(mktemp -d)
  printf '#!/bin/sh\nprintf "%%s\\n" "$*"\n' >"$FAKE/zig"
  chmod +x "$FAKE/zig"
  # -j must land right after `build`: before the step name and before `--`.
  INJ=$(./.opencode/bin/limited-build "$FAKE/zig" build single A2DE -- some/unit.o 2>&1)
  if [ "$INJ" = "build -j${DECOMP_BUILD_JOBS} single A2DE -- some/unit.o" ]; then
    ok "limited-build injects -j${DECOMP_BUILD_JOBS} after 'build' (got: $INJ)"
  else
    bad "job injection misplaced or missing. got: $INJ"
  fi
  # An explicit caller -j must be respected, never doubled up. This regressed
  # once: the old guard matched only a bare `-j`, so `-j7` was ignored and the
  # result was `-j2 -j7`, with zig honouring whichever came last.
  for form in "-j7" "-j 7" "--jobs=7" "--jobs 7"; do
    # shellcheck disable=SC2086
    INJ2=$(./.opencode/bin/limited-build "$FAKE/zig" build $form single A2DE -- u.o 2>&1)
    if [ "$INJ2" = "build $form single A2DE -- u.o" ]; then
      ok "caller '$form' respected, no double injection"
    else
      bad "caller '$form' mishandled: $INJ2"
    fi
  done
  rm -rf "$FAKE"

  if [ "$RC" -eq 0 ]; then
    ok "single-unit build SUCCEEDED (compiler present and working)"
    OBJ=$(./.opencode/bin/resolve-unit "$U" base)
    if [ -s "$OBJ" ]; then
      ok "base object produced ($(stat -c%s "$OBJ") bytes)"
    else
      bad "build reported success but $OBJ is missing or empty"
    fi
  elif echo "$CLEAN" | grep -qi 'mwccarm\.exe'; then
    ok "build reached wine and stopped only at the missing mwccarm.exe"
    printf '         %s\n' "$(echo "$CLEAN" | grep -i 'mwccarm\.exe' | head -1)"
  else
    bad "build failed somewhere other than the compiler. Errors:"
    echo "$CLEAN" | grep -iE 'error|fail|panic|cannot' | head -3 | sed 's/^/         /'
  fi
fi

sec "8c. objdiff can measure a real function (the whole point of the setup)"
# With a base object on disk, diff_overview must return real percentages from the
# live MCP server. This is the measurement the entire workflow rests on.
BASEOBJ=$(./.opencode/bin/resolve-unit "$U" base 2>/dev/null)
if [ -n "$BASEOBJ" ] && [ -s "$BASEOBJ" ]; then
  R=$(python3 - <<'PY' 2>/dev/null
import json, subprocess
p = subprocess.Popen(["./.opencode/bin/objdiff-mcp"],
                     stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                     stderr=subprocess.DEVNULL, text=True, bufsize=1)
n = [0]
def call(m, pa=None, notify=False):
    n[0] += 1
    msg = {"jsonrpc": "2.0", "method": m}
    if not notify: msg["id"] = n[0]
    if pa is not None: msg["params"] = pa
    p.stdin.write(json.dumps(msg) + "\n"); p.stdin.flush()
    return None if notify else json.loads(p.stdout.readline())
call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                    "clientInfo": {"name": "selftest", "version": "1"}})
call("notifications/initialized", {}, notify=True)
r = call("tools/call", {"name": "diff_overview",
                        "arguments": {"unit": "src/system/vblank",
                                      "only_mismatches": True, "limit": 5}})
print(r.get("result", {}).get("content", [{}])[0].get("text", ""))
p.terminate()
PY
)
  if echo "$R" | grep -qE '[0-9]+\.[0-9]+%'; then
    ok "diff_overview returns real match percentages from a compiled unit"
    echo "$R" | grep -E '[0-9]+\.[0-9]+%' | head -3 | sed 's/^/         /'
  else
    bad "diff_overview did not return match percentages"
  fi
else
  blk "no base object to measure (needs mwccarm)"
fi

sec "9. Proprietary-data boundary"
# Check paths that .gitignore actually matches. `extracted/*` and `build/*` ignore the
# contents, not the directory entry itself, so probe a real file inside each.
for p in A2DE.nds objdiff.json extracted/A2DE/config.yaml build/A2DE/delinks \
         .tools/decomp-env .decomp-ai/state.json; do
  if git check-ignore -q "$p" 2>/dev/null; then ok "gitignored: $p"; else bad "NOT gitignored: $p"; fi
done
# .gitignore must only have gained rules. A rule that merely gained a trailing
# newline shows as a -/+ pair, so compare the sets of rule lines, not the diff.
REM=$(python3 - <<'PY'
import subprocess, sys
old = subprocess.run(["git","show","HEAD:.gitignore"],capture_output=True,text=True).stdout
new = open(".gitignore").read()
def rules(t):
    return {l.strip() for l in t.splitlines()
            if l.strip() and not l.strip().startswith("#")}
lost = rules(old) - rules(new)
for l in sorted(lost):
    print("   LOST RULE:", l, file=sys.stderr)
print(len(lost))
PY
)
[ "$REM" = "0" ] && ok ".gitignore only added rules (0 removed)" || bad ".gitignore lost $REM rule(s)"
# build/.gitkeep is intentionally tracked upstream via the "!/**/.gitkeep" rule.
TRACKED=$(git ls-files | grep -iE '\.(nds|bin)$|^extracted/|^objdiff\.json$|mwccarm' | wc -l)
[ "$TRACKED" = 0 ] && ok "no ROM/compiler/object files tracked" || bad "$TRACKED proprietary paths tracked"
# Confirm the intentional .gitkeep exception is the only thing under build/.
KB=$(git ls-files build/ | tr '\n' ' ')
[ "$KB" = "build/.gitkeep " ] && ok "build/ tracks only the intentional .gitkeep" \
  || bad "unexpected tracked files under build/: $KB"

sec "10. Working state"
[ -f .decomp-ai/state.json ] && ok ".decomp-ai/state.json present" || bad "state.json missing"
[ -d .decomp-ai/best ] && ok "best-source snapshot dir present" || bad "best dir missing"
# decomp-state round trip: show (no arg) must list, and must not error.
if OUT=$(.opencode/bin/decomp-state show 2>&1); then
  ok "decomp-state show works: $(echo "$OUT" | head -1)"
else bad "decomp-state show failed: $OUT"; fi
# Snapshot + revert must restore the file byte-for-byte.
#
# Ordering matters: the "best" snapshot is taken by `record` at the moment a new
# best is reached, so the good content must already be on disk then. Add the junk
# only afterwards, exactly as a later regressing experiment would.
T="src/system/vblank.cpp"
if [ -f "$T" ]; then
  cp "$T" /tmp/opencode/.selftest-orig
  .opencode/bin/decomp-state begin "__selftest__" --unit "src/system/vblank" --source "$T" --percent 50 >/dev/null 2>&1
  .opencode/bin/decomp-state record "__selftest__" --percent 60 --hypothesis "selftest best" >/dev/null 2>&1
  printf '\n// selftest junk\n' >> "$T"
  .opencode/bin/decomp-state record "__selftest__" --percent 40 --hypothesis "selftest regression" >/dev/null 2>&1
  .opencode/bin/decomp-state revert "__selftest__" >/dev/null 2>&1
  if diff -q /tmp/opencode/.selftest-orig "$T" >/dev/null; then
    ok "best-snapshot + revert restores the source byte-for-byte"
  else
    bad "revert did not restore the source"
  fi
  # leave no trace of the test itself
  .opencode/bin/decomp-state forget "__selftest__" >/dev/null 2>&1
  cp /tmp/opencode/.selftest-orig "$T"
  if git diff --quiet -- "$T"; then
    ok "selftest left $T unchanged"
  else
    cp /tmp/opencode/.selftest-orig "$T"
    bad "selftest dirtied $T"
  fi
  rm -f /tmp/opencode/.selftest-orig
else
  bad "cannot test decomp-state: $T missing"
fi

sec "11. Permissions (V2 shape, and the failure mode that hid them)"
# A file-shape test is NOT an enforcement test. This section previously passed
# while every rule it inspected was inert. Three separate mistakes were in play:
#   * the key was `permissions` (plural) where V2 wants `permission` (singular)
#   * the action was `shell` where V2 wants `bash`
#   * the value was an array of {action,resource,effect} where V2 wants a map
#     of glob -> "allow"|"deny"|"ask"
# The deny-all entries parsed and applied; every `allow` beside them was
# discarded. Net effect: blanket shell denial for the subagents with a
# non-functional allowlist, which is why the binary analyst could not read a
# single .o file and had to infer the ELF symbol table instead.
#
# The agents are defined in .opencode/agents/*.md, so THAT is what is asserted.
# Rules are evaluated last-match-wins, so a catch-all "*" must come FIRST.
P=$(python3 - <<'PY'
import glob,json,re
try:
    import yaml
except ImportError:
    yaml=None
out={}
for p in sorted(glob.glob(".opencode/agents/*.md")):
    name=p.rsplit("/",1)[-1][:-3]
    t=open(p).read()
    m=re.match(r"^---\n(.*?)\n---\n",t,re.S)
    if not m:
        out[name]={"frontmatter":False}; continue
    if yaml is None:
        out[name]={"frontmatter":True,"unparsed":True}; continue
    fm=yaml.safe_load(m.group(1)) or {}
    perm=fm.get("permission") or {}
    out[name]={"frontmatter":True,
               "has_permission": "permission" in fm,
               "has_legacy_permissions": "permissions" in fm,
               "edit": perm.get("edit"),
               "task": perm.get("task"),
               "bash": perm.get("bash")}
print(json.dumps(out))
PY
)
[ -n "$P" ] && ok "agent frontmatter parsed" || bad "could not parse agent frontmatter (needs pyyaml)"

for a in nsmb-orchestrator nsmb-binary-analyst nsmb-matcher nsmb-reviewer; do
  g() { echo "$P" | python3 -c "import json,sys;print(json.load(sys.stdin)['$a']$1)"; }
  [ "$(g "['has_permission']")" = "True" ] \
    && ok "$a: uses 'permission' (singular, V2)" \
    || bad "$a: no 'permission' key - bash falls back to the default"
  [ "$(g "['has_legacy_permissions']")" = "False" ] \
    || bad "$a: legacy 'permissions' key present - those rules are IGNORED"
  ED=$(g "['edit']")
  if [ "$ED" != "None" ]; then
    ok "$a: edit is explicitly set ($ED)"
  else
    bad "$a: edit not set"
  fi
done

# The read-only roles must be able to read a .o file. Their absence from the
# allowlist was the original symptom of this whole bug.
for a in nsmb-binary-analyst nsmb-reviewer; do
  for t in readelf nm objdump; do
    if echo "$P" | python3 -c "
import json,sys
b=json.load(sys.stdin)['$a']['bash']
sys.exit(0 if isinstance(b,dict) and any(k.startswith('$t') for k in b) else 1)"; then
      ok "$a can run $t"
    else
      bad "$a CANNOT run $t - it cannot read object files"
    fi
  done
done

# Catch-all must precede the specifics, because the last match wins.
for a in nsmb-binary-analyst nsmb-matcher nsmb-reviewer; do
  if echo "$P" | python3 -c "
import json,sys
b=json.load(sys.stdin)['$a']['bash']
ks=list(b) if isinstance(b,dict) else []
sys.exit(0 if ks and ks[0]=='*' else 1)"; then
    ok "$a: catch-all '*' comes first (last match wins)"
  else
    bad "$a: '*' is not the first bash rule - specifics would never be reached"
  fi
done

# The matcher must reach the compiler only through the capped wrapper.
if echo "$P" | python3 -c "
import json,sys
b=json.load(sys.stdin)['nsmb-matcher']['bash']
sys.exit(0 if './.opencode/bin/*' in b and not any(k.startswith('zig') for k in b) else 1)"; then
  ok "nsmb-matcher builds only via ./.opencode/bin/* (no bare zig)"
else
  bad "nsmb-matcher can invoke zig directly, bypassing the CPU cap"
fi

# The guardrails that matter most: never push upstream, never destroy the tree.
if echo "$P" | python3 -c "
import json,sys
d=json.load(sys.stdin)
b=d['nsmb-matcher']['bash']
sys.exit(0 if b.get('git push upstream*','allow')=='deny' else 1)"; then
  ok "nsmb-matcher: git push upstream is denied"
else
  bad "nsmb-matcher can push to upstream"
fi

if grep -q '"git push upstream\*": "deny"' opencode.jsonc 2>/dev/null; then
  ok "global floor: git push upstream denied"
else
  bad "global permission floor is missing the upstream-push deny"
fi
if grep -q '"git reset --hard\*": "deny"' opencode.jsonc 2>/dev/null; then
  ok "global floor: git reset --hard denied"
else
  bad "global permission floor is missing the reset --hard deny"
fi

# The agents must not be duplicated into opencode.jsonc under a key the docs
# do not define; markdown is the single source of truth.
if grep -q '^  "agents":' opencode.jsonc 2>/dev/null; then
  bad "opencode.jsonc still defines an 'agents' block (docs say 'agent', singular)"
else
  ok "opencode.jsonc has no duplicate agent definitions"
fi

# A duplicate mapping key makes OpenCode discard the WHOLE frontmatter and fall
# back to using the raw file as the system prompt - the agent then silently runs
# with mode=primary, no model, and default permissions. PyYAML tolerates
# duplicates (last wins), so a naive safe_load check passes and hides it. Only a
# duplicate-rejecting loader catches it. This actually happened to
# nsmb-matcher, whose bash map listed "stat *" and "file *" twice.
DUP=$(python3 -c "
import glob,re,yaml
class Strict(yaml.SafeLoader): pass
def nodup(loader,node,deep=False):
    keys=[]
    for k,_ in node.value:
        kk=loader.construct_object(k,deep=deep)
        if kk in keys:
            raise yaml.constructor.ConstructorError(None,None,'duplicate key %r'%kk,k.start_mark)
        keys.append(kk)
    return yaml.SafeLoader.construct_mapping(loader,node,deep)
Strict.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,nodup)
bad=[]
for p in sorted(glob.glob('.opencode/agents/*.md')):
    m=re.match(r'^---\n(.*?)\n---\n',open(p).read(),re.S)
    if not m: continue
    try: yaml.load(m.group(1),Loader=Strict)
    except Exception as e: bad.append(p.rsplit('/',1)[-1])
print(','.join(bad))" 2>/dev/null)
if [ -z "$DUP" ]; then
  ok "no duplicate YAML keys in agent frontmatter (strict parse)"
else
  bad "duplicate YAML keys in: $DUP - OpenCode will discard the whole frontmatter"
fi

# And confirm each agent really loaded its frontmatter, rather than being
# registered from the raw file as a system prompt.
LOADED=$(opencode debug agents 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
n=0
for a in d:
    if not a.get('name','').startswith('nsmb'): continue
    if (a.get('model') or {}).get('variant')=='max' and not str(a.get('system','')).startswith('---'): n+=1
print(n)" 2>/dev/null || echo 0)
[ "$LOADED" = 4 ] && ok "all 4 agents loaded frontmatter (model+variant resolved)" \
  || bad "only $LOADED/4 agents resolved a model - frontmatter not parsed"

command -v gh >/dev/null 2>&1 && ok "gh available: $(gh --version 2>/dev/null | head -1)" || bad "gh missing (PR creation)"
gh auth status >/dev/null 2>&1 && ok "gh authenticated as mrzetti (repo scope)" \
  || bad "gh not authenticated - PR creation will fail"

# NOTE: everything above validates FILES. It cannot prove OpenCode has LOADED
# them. Measured on 2.0.18: `opencode reload` prints "Configuration reloaded"
# and `opencode debug config` still serves the previous document, so a restart
# is what actually applies a change.
# Control experiment that pinned the default: a subagent with no permission
# block is denied bash, while one with "permission":{"bash":"allow"} is not.

sec "RESULT"
printf '  PASS %d   FAIL %d   BLOCKED %d\n\n' "$NPASS" "$NFAIL" "$NBLOCK"
[ "$NFAIL" = 0 ] || exit 1
exit 0
